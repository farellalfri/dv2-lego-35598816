{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Licensed sets only arrived in 1999, but have been LEGO's largest theme group every year since 2015",
    "subtitle": "Number of sets released each year by theme group, 1970 to 2025. Drag across the grey strip to zoom into a period.",
    "anchor": "start"
  },
  "data": {"url": "data/sets_rebrickable.csv"},
  "vconcat": [
    {
      "width": 800,
      "height": 200,
      "transform": [{"filter": {"param": "brush"}}],
      "mark": {"type": "rect", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": null,
              "axis": {"labelExpr": "datum.value % 10 === 0 ? datum.value : ''",
                       "labelAngle": 0, "ticks": false}},
        "y": {"field": "theme_group", "type": "nominal", "title": null,
              "sort": ["Licensed", "Modern day", "Action/Adventure", "Historical",
                       "Technical", "Young children", "Other"],
              "axis": {"ticks": false, "domain": false}},
        "color": {"aggregate": "count", "type": "quantitative", "title": "Sets released",
                  "scale": {"type": "threshold", "domain": [10, 25, 50, 100, 200],
                            "range": ["#ffffd4", "#fee391", "#fec44f",
                                      "#fe9929", "#d95f0e", "#993404"]}},
        "tooltip": [
          {"field": "theme_group", "title": "Theme group"},
          {"field": "year", "title": "Year"},
          {"aggregate": "count", "title": "Sets released"}
        ]
      }
    },
    {
      "width": 800,
      "height": 40,
      "params": [{"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "area", "color": "#bbbbbb"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative", "title": "Drag here to choose a period",
              "axis": {"format": "d", "tickCount": 12}},
        "y": {"aggregate": "count", "type": "quantitative", "axis": null}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}