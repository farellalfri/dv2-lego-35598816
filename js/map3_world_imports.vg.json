{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The United States imports about 60 times more toys and games than Malaysia",
    "subtitle": "Imports of toys, games and sports goods, USD billion",
    "anchor": "start"
  },
  "width": "container",
  "height": 560,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "js/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dce9f3"
      }
    },
    {
      "data": {
        "url": "js/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2f2f2",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "js/world_graticules_30.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#9db4c6",
        "strokeWidth": 0.6,
        "strokeDash": [
          3,
          3
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "properties": {
              "name": "Equator"
            },
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  -180,
                  0
                ],
                [
                  -90,
                  0
                ],
                [
                  0,
                  0
                ],
                [
                  90,
                  0
                ],
                [
                  180,
                  0
                ]
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "name": "Prime meridian"
            },
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  0,
                  -90
                ],
                [
                  0,
                  -45
                ],
                [
                  0,
                  0
                ],
                [
                  0,
                  45
                ],
                [
                  0,
                  90
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#5f7a90",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": -179,
            "lat": 0,
            "text": "Equator (0\u00b0)"
          },
          {
            "lon": 1,
            "lat": -84,
            "text": "Prime meridian (0\u00b0)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#3f566a",
        "dx": 4,
        "dy": -5,
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "url": "data/toy_imports.csv"
      },
      "mark": {
        "type": "circle",
        "stroke": "white",
        "strokeWidth": 1,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "import_usd_b",
          "type": "quantitative",
          "title": "Imports (USD billion)",
          "scale": {
            "range": [
              0,
              2500
            ]
          },
          "legend": {
            "values": [
              1,
              10,
              50
            ],
            "symbolFillColor": "#999",
            "symbolStrokeColor": "white"
          }
        },
        "color": {
          "field": "highlight",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Malaysia",
              "Australia",
              "Other"
            ],
            "range": [
              "#c91a09",
              "#0055bf",
              "#888888"
            ]
          }
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "import_usd_b",
            "title": "Imports (USD billion)",
            "format": ",.2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/toy_imports.csv"
      },
      "transform": [
        {
          "filter": "datum.highlight != 'Other'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "country"
        },
        "color": {
          "field": "highlight",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Malaysia",
              "Australia",
              "Other"
            ],
            "range": [
              "#c91a09",
              "#0055bf",
              "#888888"
            ]
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}