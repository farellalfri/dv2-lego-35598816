{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Lion Knights' Castle costs 18% of a month's household spending in Putrajaya, but 46% in Sabah",
    "subtitle": "Circle size: population (2024). Colour: RM 1,636 set as a share of mean monthly household spending (2024).",
    "anchor": "start"
  },
  "data": {
    "url": "data/dorling_states.csv",
    "format": {"type": "csv", "parse": {"x": "number", "y": "number", "area_px": "number",
               "population_k": "number", "expenditure_mean": "number", "share_pct": "number"}}
  },
  "width": 560,
  "height": 230,
  "encoding": {
    "x": {"field": "x", "type": "quantitative", "axis": null,
          "scale": {"domain": [0, 560], "nice": false, "zero": false}},
    "y": {"field": "y", "type": "quantitative", "axis": null,
          "scale": {"domain": [0, 230], "nice": false, "zero": false, "reverse": true}}
  },
  "layer": [
    {
      "mark": {"type": "circle", "opacity": 1, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "size": {"field": "area_px", "type": "quantitative", "legend": null,
                 "scale": {"domain": [0, 7000], "range": [0, 7000]}},
        "color": {"field": "share_pct", "type": "quantitative", "title": "% of monthly spending",
                  "scale": {"type": "threshold", "domain": [25, 30, 35, 40],
                            "range": ["#ffffd4", "#fed98e", "#fe9929", "#d95f0e", "#993404"]}},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "population_k", "type": "quantitative", "title": "Population (thousands)", "format": ",.0f"},
          {"field": "expenditure_mean", "type": "quantitative", "title": "Mean monthly spending (RM)", "format": ","},
          {"field": "share_pct", "type": "quantitative", "title": "Set price as % of spending", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.area_px > 1400"},
        {"calculate": "datum.label == 'Pulau Pinang' ? 'Penang' : datum.label == 'Negeri Sembilan' ? 'N. Sembilan' : datum.label == 'Kuala Lumpur' ? 'KL' : datum.label",
         "as": "short_label"}
      ],
      "mark": {"type": "text", "fontSize": 10, "fontWeight": "bold"},
      "encoding": {
        "text": {"field": "short_label", "type": "nominal"},
        "color": {"condition": {"test": "datum.share_pct >= 35", "value": "white"}, "value": "black"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}